{
  "name": "omp-vscode",
  "displayName": "omp",
  "description": "Ставит Bun и omp в папку расширения и запускает omp в Git Bash на Windows",
  "version": "0.0.1",
  "publisher": "arqawa",
  "repository": {
    "type": "git",
    "url": "https://github.com/ARQAWA/my-omp-harness.git"
  },
  "engines": {
    "vscode": "^1.86.0"
  },
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      { "command": "omp.prepare", "title": "Prepare Environment", "category": "OMP" },
      { "command": "omp.newTab", "title": "New Tab", "category": "OMP" },
      { "command": "omp.removeAll", "title": "Remove All", "category": "OMP" }
    ]
  }
}
